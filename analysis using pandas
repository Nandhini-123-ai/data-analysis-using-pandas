df = pd.read_csv("GoogleAds_DataAnalytics_Sales_Cleaned.csv")
print("Total Cost:", df["Cost"].sum())
print("Total Sales:", df["Sale_Amount"].sum())
print("Total Clicks:", df["Clicks"].sum())
print("Total Leads:", df["Leads"].sum())
print("Total Conversions:",
      df["Conversions"].sum()
)
campaign_sales = df.groupby("Campaign_Name")["Sale_Amount"].sum()
print(campaign_sales.sort_values(ascending=False))
location_sales = df.groupby("Location")["Sale_Amount"].sum()
print(location_sales.sort_values(ascending=False))
device_sales = df.groupby("Device")["Sale_Amount"].sum()
